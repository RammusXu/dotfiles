{{- /* 換機/多機設定：init 時問一次，答案存在 ~/.config/chezmoi/chezmoi.toml */ -}}
{{- /* 注意：提問文字會被 `chezmoi init --promptString "<提問文字>=<值>"` 當成 key，
       所以裡面不要出現 = 或 , —— 否則沒辦法非互動式帶入答案。 */ -}}
{{- $role := promptStringOnce . "role" "Machine role: primary (日常主力機，裝 GUI) 或 runner (備援背景機，只裝 CLI)" "primary" -}}
{{- /* 公司身分不寫進這個 public repo，只留在這台機器的 chezmoi.toml。
       注意：不問「這台是不是公司的電腦」—— 身分是由目錄決定的
       （~/workspace/ → 公司，~/personal/ → 個人），每台機器都可能兩種都有，
       所以每台機器都要有公司身分的值。 */ -}}
{{- $workName := promptStringOnce . "workName" "公司 git 身分 name（例：yourname-company）" "you-work" -}}
{{- $workEmail := promptStringOnce . "workEmail" "公司 git 身分 email（例：you@company.com）" "you@company.com" -}}

# 編輯位置就是 chezmoi 的 source dir —— 只有一份 clone，不會有兩份互相漂移。
# chezmoi 預設會用 ~/.local/share/chezmoi，這行把它改掉。
#
# ⚠️ 因此 bootstrap 那一行【一定】要帶 --source：
#      chezmoi init --apply --source=~/personal/dotfiles rammusxu
#    忘了帶的話 chezmoi 會 clone 到 ~/.local/share/chezmoi，但這個 config
#    又指向 ~/personal/dotfiles（空的）—— 症狀是 `chezmoi managed` 什麼都沒有，
#    而且【不會報錯】。實測確認過這個行為。
sourceDir = {{ (joinPath .chezmoi.homeDir "personal/dotfiles") | quote }}

[data]
    role = {{ $role | quote }}
    workName = {{ $workName | quote }}
    workEmail = {{ $workEmail | quote }}
