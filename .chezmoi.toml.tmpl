{{- /* 換機/多機設定：init 時問一次，答案存在 ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $role := promptStringOnce . "role" "Machine role (primary = 日常主力機 / runner = 備援背景機)" "primary" -}}
{{- $isWork := promptBoolOnce . "isWork" "這台是誠品的工作機嗎" -}}

# 編輯位置就是 chezmoi 的 source dir —— 只有一份 clone，不會有兩份互相漂移。
# chezmoi 預設會用 ~/.local/share/chezmoi，這行把它改掉。
#
# ⚠️ 因此 bootstrap 那一行【一定】要帶 --source：
#      chezmoi init --apply --source=~/personal/dotfiles rammusxu
#    忘了帶的話 chezmoi 會 clone 到 ~/.local/share/chezmoi，但這個 config
#    又指向 ~/personal/dotfiles（空的）—— 症狀是 `chezmoi managed` 什麼都沒有，
#    而且【不會報錯】。實測確認過這個行為。
sourceDir = {{ (joinPath .chezmoi.homeDir "personal/dotfiles") | quote }}

[data]
    role = {{ $role | quote }}
    isWork = {{ $isWork }}
