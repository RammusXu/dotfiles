# GUI 應用程式 — 只有 role = primary 的機器會裝。
# 這些 cask 幾乎都是 auto_updates true，讓 app 自己更新，
# 不要用 `brew upgrade --cask --greedy` 去接管它們。

# --- 每天在用 ---
cask "google-chrome"
cask "visual-studio-code"
cask "obsidian"
cask "linear-linear"          # 注意 token 是 linear-linear，不是 linear
cask "bitwarden"
cask "ghostty"
cask "claude-code"

# --- dev ---
cask "docker-desktop"         # 首次啟動需要授權，見 Brewfile.manual
cask "session-manager-plugin"

# --- 通訊 ---
cask "telegram"

