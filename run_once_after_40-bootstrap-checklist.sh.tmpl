#!/bin/bash
# 新機 apply 完之後印一份「chezmoi 管不到的」待辦。
# 刻意全部只檢查不失敗 —— bootstrap 不該因為少一個 secret 就整個中斷。
set -uo pipefail
H="{{ .chezmoi.homeDir }}"
WORK_EMAIL="{{ if hasKey . "workEmail" }}{{ .workEmail }}{{ else }}you@company.com{{ end }}"
echo
echo "──────────── bootstrap 檢查 ────────────"

[ -f "$H/.zshenv" ] \
  && echo "  ✅ ~/.zshenv（secrets）" \
  || echo "  ⬜ ~/.zshenv  →  export BW_SESSION=\$(bw unlock --raw) && {{ .chezmoi.sourceDir }}/scripts/secrets-restore.sh"

[ -f "$H/.env" ] \
  && echo "  ⚠️  ~/.env 是舊位置 →  mv ~/.env ~/.zshenv && {{ .chezmoi.sourceDir }}/scripts/secrets-backup.sh"

case "$WORK_EMAIL" in
  you@company.com|"")
    echo "  ⬜ 公司 git 身分還是佔位字串 →  chezmoi init  （重答 workName / workEmail）" ;;
  *)
    echo "  ✅ 公司 git 身分（~/workspace/ 底下的 repo 會用它）" ;;
esac

ls "$H"/.ssh/id_* >/dev/null 2>&1 \
  && echo "  ✅ SSH key" \
  || echo "  ⬜ SSH key →  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_work -C '$WORK_EMAIL'"

gh auth status >/dev/null 2>&1 \
  && echo "  ✅ gh 已登入" \
  || echo "  ⬜ gh 登入  →  gh auth login  (選 HTTPS) && gh auth setup-git"

echo "  ⬜ Brewfile.manual：Docker Desktop 授權、Xnip (MAS)、Orca"
echo "  ⬜ Dock 排列 / 輸入法（手動，3 分鐘）"
echo "────────────────────────────────────────"
echo
