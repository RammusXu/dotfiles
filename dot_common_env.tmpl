# Load .env, won't managed by chezmoi to avoid secrets leak
# 新機提醒：這個檔案不在版控裡，換機時要手動從舊機複製 ~/.env 過來。
if [ -f "{{ .chezmoi.homeDir }}/.env" ]; then
    source "{{ .chezmoi.homeDir }}/.env"
fi

# Load common aliases
if [ -f "{{ .chezmoi.homeDir }}/.bash_alias" ]; then
    source "{{ .chezmoi.homeDir }}/.bash_alias"
fi

# Add common bin paths
export PATH="$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"

# Google Cloud SDK — 官方 archive 安裝（見 run_onchange_after_30-gcloud.sh）
# 刻意不用 homebrew cask：cask 版 depends_on python@3.x，brew 升 python 時 gcloud 會壞。
if [ -f "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.zsh.inc" ]; then
    source "{{ .chezmoi.homeDir }}/google-cloud-sdk/path.zsh.inc"
fi

# rbenv — guard 起來，新機在 brew bundle 跑完前不會噴錯
if command -v rbenv >/dev/null 2>&1; then
    eval "$(rbenv init - --no-rehash zsh)"
fi

# bun
if [ -d "$HOME/.bun" ]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
fi
