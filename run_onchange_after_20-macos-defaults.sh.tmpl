{{- if (eq .chezmoi.os "darwin") -}}
{{- $role := "primary" -}}{{- if hasKey . "role" -}}{{- $role = .role -}}{{- end -}}
#!/bin/bash
# macOS 系統偏好 — 只管「跨版本穩定 + 你真的在乎」的少數 key。
#
# 三個原則：
#   1. 每個 key 都要有註解說明它做什麼，以及最後在哪個 macOS 版本驗證過
#   2. 全部 `|| true`：key 在新版 macOS 消失是正常的，不該讓整個 apply 失敗
#   3. 需要 TCC 授權的東西（輔助使用、螢幕錄製、完整磁碟取用）一律不寫
#      —— 那些存在 SIP 保護的資料庫裡，defaults 寫不進去，硬寫只會壞掉
#
# verified_on: macOS 26 (Tahoe)
# 舊機實際設定 dump：scripts/macos-defaults-dump.sh

set -uo pipefail
echo "==> ⚙️  套用 macOS defaults"

# ---------- 鍵盤 ----------
# 按鍵重複速度（數字越小越快）
defaults write NSGlobalDomain KeyRepeat -int 2 || true
defaults write NSGlobalDomain InitialKeyRepeat -int 15 || true
# 關掉長按叫出重音字元選單，改成重複輸入（寫程式必要）
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false || true

# ---------- Finder ----------
# 顯示副檔名
defaults write NSGlobalDomain AppleShowAllExtensions -bool true || true
# 顯示路徑列與狀態列
defaults write com.apple.finder ShowPathbar -bool true || true
defaults write com.apple.finder ShowStatusBar -bool true || true
# 預設用清單檢視（Nlsv=list, icnv=icon, clmv=column, Flwv=gallery）
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv" || true
# 搜尋預設範圍為目前資料夾
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf" || true
# 不要在改副檔名時警告
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false || true

# ---------- 截圖 ----------
defaults write com.apple.screencapture location -string "{{ .chezmoi.homeDir }}/Desktop" || true
defaults write com.apple.screencapture type -string "png" || true
defaults write com.apple.screencapture disable-shadow -bool true || true

# ---------- 觸控板：三指拖移 ----------
# 這個在「輔助使用 > 指標控制 > 觸控式軌跡板選項」裡，但可以用 defaults 寫。
# 兩個 domain 都要寫（內建觸控板 + 藍牙觸控板），跨版本相對穩定。
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true || true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true || true

# ---------- 其他 ----------
# 存檔對話框預設展開
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true || true
# 關掉自動大寫 / 智慧引號（寫程式會被害到）
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false || true
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false || true
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false || true

{{ if ne $role "primary" }}
# ---------- runner（背景機）專用 ----------
# 蓋上不睡、允許網路喚醒。需要 sudo，所以只印指令不自動執行。
echo "    ℹ️  背景機請手動跑： sudo pmset -a sleep 0 disksleep 0 womp 1"
{{ end }}

killall Finder >/dev/null 2>&1 || true
killall SystemUIServer >/dev/null 2>&1 || true
echo "==> ✅ macOS defaults 套用完成（部分設定需登出重入才生效）"

# ---------- 刻意「不」用 script 管的東西 ----------
# Dock 的 app 排列 (com.apple.dock persistent-apps)：
#   巢狀 plist，格式在 macOS 版本之間改過，維護成本遠高於價值。
#   而且換新機本來就該重新想一次 Dock 要放什麼。手動排 3 分鐘。
# 桌布、Safari 設定、密碼、鍵盤快捷鍵：
#   走 iCloud / Apple ID 同步，登入就有，不需要 script。
{{- end -}}
